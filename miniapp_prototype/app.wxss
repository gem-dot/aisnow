page {
  background: #f8fafc;
  color: #0f172a;
  font-size: 28rpx;
}

.container {
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.subtle {
  color: #64748b;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.btn-primary {
  background: #2563eb;
  color: #ffffff;
}

.btn-ghost {
  background: #e2e8f0;
  color: #0f172a;
}

.input {
  border: 2rpx solid #cbd5e1;
  border-radius: 16rpx;
  padding: 16rpx 18rpx;
  margin-top: 12rpx;
}

.badge {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #dbeafe;
  color: #1d4ed8;
  font-size: 24rpx;
  margin-right: 12rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.metric {
  font-size: 24rpx;
  color: #334155;
  margin-top: 8rpx;
}

.video {
  width: 100%;
  border-radius: 16rpx;
  margin-top: 16rpx;
}

.thumb {
  width: 100%;
  border-radius: 16rpx;
  margin-top: 16rpx;
}
